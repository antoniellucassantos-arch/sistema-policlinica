# ==========================================================
# CONFIGURAÇÃO DO MEDAGENDA
# Copie este arquivo para ".env" e preencha os valores.
# ==========================================================

# Porta do servidor
PORT=3000

# Endereço público do sistema (usado no link de "esqueci minha senha")
APP_URL=http://localhost:3000

# Chave secreta das sessões. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Fuso horário da clínica (para saber "hoje" e horários passados)
FUSO_HORARIO=America/Sao_Paulo

# ---------- Banco de dados ----------
# sqlite (padrão, não precisa instalar nada), postgres ou mysql
DB_CLIENT=sqlite

# Usado só com SQLite
SQLITE_FILE=data/medagenda.sqlite

# Usado com PostgreSQL ou MySQL, por exemplo:
#   postgres://usuario:senha@localhost:5432/medagenda
#   mysql://usuario:senha@localhost:3306/medagenda
DATABASE_URL=

# ---------- Primeiro administrador ----------
# Criado automaticamente na primeira vez que o servidor iniciar.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# ---------- E-mail (recuperação de senha) ----------
# Sem SMTP, o link de recuperação aparece no terminal do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="MedAgenda <nao-responda@suaclinica.com.br>"

# ---------- Produção ----------
# Use true quando o site estiver em HTTPS
COOKIE_SECURE=false
# Defina quando estiver atrás de proxy reverso (nginx, Render, Railway...), ex.: 1
TRUST_PROXY=
